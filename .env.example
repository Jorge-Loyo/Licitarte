# Licitarte - Variables de Entorno
# Copiar este archivo como .env y completar con valores reales

# Base de Datos
# Para desarrollo local (SQLite): dejar vacío
# Para producción (PostgreSQL): postgresql://usuario:password@host:5432/dbname
DATABASE_URL=

# Seguridad
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Entorno
# Valores: development, production
FLASK_ENV=development

# Puerto (opcional, por defecto 5000)
PORT=5000
